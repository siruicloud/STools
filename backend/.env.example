# ============================================================
# seaman 插件市场后端环境配置
# 复制为 .env 后修改（生产环境勿提交真实密码）
#
# 数据库驱动：sqlite（默认，零依赖）| mysql（生产推荐）
# ============================================================

# 数据库驱动
DB_DRIVER=mysql

# MySQL 连接配置（DB_DRIVER=mysql 时生效）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=api
DB_USER=seaman
DB_PASS=your_strong_password

# ━━━ 接口限流（RateLimitMiddleware）━━━━━━━━━━━━━━━━━━━━━━━━━
# RATE_LIMIT_ENABLED: true 开启 / false 关闭
# *_MAX: 每 IP 每个时间窗口内允许的请求次数（0 = 不限流）
# *_WINDOW: 时间窗口（秒）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WRITE_WINDOW=60
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_READ_WINDOW=60
